{
  "name": "convertin",
  "version": "2.1.3",
  "description": "Convertin // Offline Media & File Converter",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "package": "tsc && vite build && electron-builder --dir",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.convertin.desktop",
    "productName": "Convertin",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": ["**/*"]
      },
      {
        "from": "resources/icons",
        "to": "icons",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "dir",
      "icon": "resources/icons/app_tray.ico"
    }
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
